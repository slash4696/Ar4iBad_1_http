# Copy this file to .env before starting with Docker Compose.
POSTGRES_PASSWORD=replace-with-a-long-random-password
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=https://your-domain.example
DATABASE_URL=postgresql://portfolio:replace-with-a-long-random-password@db:5432/portfolio
# Optional: send a lead to your private Telegram chat only after the visitor opts in.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
